# Copiar este archivo como backend/.env y completar los valores. backend/.env nunca se versiona.

# Clave de la API de Gemini (https://aistudio.google.com/apikey).
# Si queda vacía, el backend usa la evaluación determinista de reglas (ai_source = "fallback").
GEMINI_API_KEY=

# Modelo de Gemini que redacta el feedback del Directorio.
GEMINI_MODEL=gemini-3.5-flash-lite
